{
  "name": "moli-webonderzoek",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "python": ">=3.11"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "package": "python3 scripts/package.py",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "origins": "node scripts/origins.mjs",
    "connect": "node scripts/connect-codex.mjs",
    "demo": "node scripts/demo.mjs",
    "release:check": "python3 scripts/check-release.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "playwright-core": "1.62.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.6"
  },
  "description": "Local MCP web research with Moli, source evidence and snapshot comparisons",
  "license": "MIT"
}
